# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_CLERK_PUBLISHABLE_KEY: Clerk Publishable Key (starts with pk_test_ or pk_live_).
# Copy from Clerk Dashboard > API keys.
VITE_CLERK_PUBLISHABLE_KEY=""

# Razorpay Payment Integration
# Client-facing Razorpay Key ID (starts with rzp_live_ or rzp_test_)
VITE_RAZORPAY_KEY_ID="rzp_live_Tj2WkYSgUgzyJr"

# Server-only Razorpay Key Secret (never expose to client)
RAZORPAY_KEY_SECRET=""

# Azure SQL Database Configuration (Server-Side)
# Confirmed Infrastructure:
AZURE_SQL_SERVER="faneme.database.windows.net"
AZURE_SQL_DATABASE="fanqme"
AZURE_SQL_PORT="1433"

# Microsoft Entra (Azure AD) Service Principal Authentication
# Required for production server-side Entra authentication:
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Optional SQL authentication fallback (if Entra is not yet provisioned):
AZURE_SQL_USER=""
AZURE_SQL_PASSWORD=""

# Buy Me a Coffee Creator API (server-side only, read-only token)
BUYMEACOFFEE_ACCESS_TOKEN=""

# Automated SEO, Search Engine Verification & Telemetry
SEO_ADMIN_EMAILS=""
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
GSC_SERVICE_ACCOUNT_JSON=""
GSC_SITE_URL="https://iveo.site"
BING_WEBMASTER_API_KEY=""
INDEXNOW_KEY=""
