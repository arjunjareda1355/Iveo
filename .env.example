# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / SITE_URL: The canonical URL where this applet is hosted.
# Used for self-referential links, SEO canonicals, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
SITE_URL=""

# VITE_CLERK_PUBLISHABLE_KEY: Clerk Publishable Key (starts with pk_test_ or pk_live_).
# Copy from Clerk Dashboard > API keys.
VITE_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY: Optional server-side Clerk token verification key for authenticated mutations.
CLERK_SECRET_KEY=""

# TOKEN_ENCRYPTION_KEY: 32+ char server secret used to encrypt stored OAuth tokens (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=""

# Razorpay Payment Integration
# Client-facing Razorpay Key ID (set in server & client env)
VITE_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""

# Server-only Razorpay Key Secret & Webhook Secret (never expose to client)
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Azure SQL Database Configuration (Server-Side)
AZURE_SQL_SERVER=""
AZURE_SQL_DATABASE=""
AZURE_SQL_PORT="1433"

# Microsoft Entra (Azure AD) Service Principal Authentication
# Required for production server-side Entra authentication:
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Optional SQL authentication fallback (if Entra is not yet provisioned):
AZURE_SQL_USER=""
AZURE_SQL_PASSWORD=""

# Buy Me a Coffee Creator API (server-side only, read-only token)
BUYMEACOFFEE_ACCESS_TOKEN=""

# Automated SEO, Search Engine Verification & Telemetry
SEO_ADMIN_EMAILS=""
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
GSC_SERVICE_ACCOUNT_JSON=""
GSC_SITE_URL="https://iveo.site"
BING_WEBMASTER_API_KEY=""
INDEXNOW_KEY=""

# Google OAuth 2.0 (Server-Side Only for YouTube Showcase)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# YouTube Data API v3 (Server-Side Only, optional)
YOUTUBE_API_KEY=""

# GitHub Read-Only Public Token (Server-Side Only, optional)
GITHUB_TOKEN=""

# Social OAuth & Card Embed Integrations (Server-Side Only; Discord is for user page embeds only)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI=""
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
PINTEREST_ACCESS_TOKEN=""
PINTEREST_OAUTH_ENABLED="false"
TWITCH_CLIENT_ID=""
TWITCH_ACCESS_TOKEN=""
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""

