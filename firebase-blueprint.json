{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile settings, appearance vibe, socials, SEO settings, and branding configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 128 },
        "bio": { "type": "string", "maxLength": 500 },
        "avatarUrl": { "type": "string", "maxLength": 2048 },
        "avatarData": { "type": "string", "maxLength": 350000 },
        "avatarType": { "type": "string", "enum": ["default", "uploaded"] },
        "avatarId": { "type": "string", "maxLength": 64 },
        "vibeId": { "type": "string", "maxLength": 32 },
        "buttonShape": { "type": "string", "enum": ["square", "rounded", "pill"] },
        "socials": { "type": "object" },
        "socialsPosition": { "type": "string", "enum": ["top", "bottom", "both"] },
        "primaryEmail": { "type": "string", "maxLength": 320 },
        "fontSettings": { "type": "object" },
        "buttonColors": { "type": "object" },
        "layoutSettings": { "type": "object" },
        "background": { "type": "object" },
        "businessCard": { "type": "object" },
        "appearance": { "type": "object" },
        "plan": { "type": "string", "enum": ["free", "pro"] },
        "subscription": { "type": "object" },
        "status": { "type": "string", "maxLength": 32 },
        "isPublished": { "type": "boolean" },
        "hideFooter": { "type": "boolean" },
        "hideFromSearch": { "type": "boolean" },
        "googleAnalyticsId": { "type": "string", "maxLength": 64 },
        "metaPixelId": { "type": "string", "maxLength": 64 },
        "whatsappNumber": { "type": "string", "maxLength": 32 },
        "customSeoTitle": { "type": "string", "maxLength": 160 },
        "customSeoDescription": { "type": "string", "maxLength": 320 },
        "blocksInitialized": { "type": "boolean" },
        "deletedAt": { "type": "string", "maxLength": 64 },
        "purgeAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["username"]
    },
    "PageBlock": {
      "title": "PageBlock",
      "description": "Individual link, embed, contact card, showcase, product, booking, or interactive block on user page",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "kind": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 256 },
        "url": { "type": "string", "maxLength": 2048 },
        "icon": { "type": "string", "maxLength": 128 },
        "thumbnailPath": { "type": "string", "maxLength": 512 },
        "thumbnailUrl": { "type": "string", "maxLength": 2048 },
        "layout": { "type": "string", "maxLength": 32 },
        "embedProvider": { "type": "string", "maxLength": 32 },
        "embedMeta": { "type": "object" },
        "signup": { "type": "object" },
        "tipJar": { "type": "object" },
        "coffee": { "type": "object" },
        "faq": { "type": "object" },
        "vcard": { "type": "object" },
        "youtube": { "type": "object" },
        "product": { "type": "object" },
        "booking": { "type": "object" },
        "countdown": { "type": "object" },
        "promo": { "type": "object" },
        "location": { "type": "object" },
        "download": { "type": "object" },
        "bluesky": { "type": "object" },
        "animation": { "type": "string", "maxLength": 32 },
        "badge": { "type": "string", "maxLength": 40 },
        "position": { "type": "number" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "isProtected": { "type": "boolean" },
        "startAt": { "type": "string", "maxLength": 64 },
        "endAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "kind", "title"]
    },
    "PageContact": {
      "title": "PageContact",
      "description": "Subscriber contact lead captured via user signup block",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "linkId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 320 },
        "phone": { "type": "string", "maxLength": 32 },
        "consentText": { "type": "string", "maxLength": 500 },
        "source": { "type": "string", "maxLength": 120 },
        "formTitle": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId"]
    },
    "BlockClickCount": {
      "title": "BlockClickCount",
      "description": "Aggregated click counter for link analytics",
      "type": "object",
      "properties": {
        "blockId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "count": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["blockId", "count"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Raw page view and link click event for analytics reporting",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "eventType": { "type": "string", "enum": ["page_view", "link_click"] },
        "blockId": { "type": "string", "maxLength": 128 },
        "country": { "type": "string", "maxLength": 120 },
        "referrer": { "type": "string", "maxLength": 120 },
        "device": { "type": "string", "enum": ["mobile", "tablet", "desktop", "other"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "username", "eventType", "createdAt"]
    },
    "ClaimRecord": {
      "title": "ClaimRecord",
      "description": "Unique username registry record preventing duplicate claims",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 32 },
        "claimedAt": { "type": "string", "maxLength": 64 },
        "releasedAt": { "type": "string", "maxLength": 64 },
        "deletedAt": { "type": "string", "maxLength": 64 },
        "purgeAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["username"]
    },
    "RedirectRecord": {
      "title": "RedirectRecord",
      "description": "Handle rename redirect mapping old username to current username",
      "type": "object",
      "properties": {
        "from": { "type": "string", "maxLength": 64 },
        "to": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["from", "to", "updatedAt"]
    },
    "AppearanceV2State": {
      "title": "AppearanceV2State",
      "description": "Version 2 structured appearance configuration, undo/redo history, and saved themes",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "appearance": { "type": "object" },
        "history": { "type": "object" },
        "themes": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["username", "userId", "updatedAt"]
    }
  },
  "firestore": {
    "/claims/{username}": {
      "schema": { "$ref": "#/entities/ClaimRecord" },
      "description": "Global atomic username reservations registry"
    },
    "/redirects/{username}": {
      "schema": { "$ref": "#/entities/RedirectRecord" },
      "description": "Handle rename redirect mappings"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public and private user page profile configurations"
    },
    "/users/{userId}/blocks/{blockId}": {
      "schema": { "$ref": "#/entities/PageBlock" },
      "description": "Blocks and links belonging to the user's page"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/PageContact" },
      "description": "Collected subscriber contacts for the page owner"
    },
    "/users/{userId}/clicks/{clickId}": {
      "schema": { "$ref": "#/entities/BlockClickCount" },
      "description": "Click telemetry counter records for user links"
    },
    "/users/{userId}/analytics/{eventId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "Durable page view and link click analytics events"
    },
    "/users/{userId}/appearance/{docId}": {
      "schema": { "$ref": "#/entities/AppearanceV2State" },
      "description": "Version 2 structured appearance configuration, history, and themes"
    }
  }
}
